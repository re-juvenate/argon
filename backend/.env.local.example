# copy to .env.local (gitignored) and run: uv run --env-file .env.local uvicorn main:app --app-dir src --reload

# agent (/agent)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
AGENT_MAX_TOKENS=8000
SESSION_SECRET=change-me-to-32-plus-random-bytes
SESSION_TTL_SECONDS=86400
SESSION_DIR=/tmp/argon-sessions
CORS_ORIGINS=http://localhost:5173

# pulumi deployments (/deployments)
PULUMI_BACKEND_URL=file://~
PULUMI_CONFIG_PASSPHRASE=
PULUMI_PROJECT=argon
# PULUMI_HOME=

# freeform runner (/runs)
RUNNER_ROOT=/tmp/argon-runs
RUNNER_WORKERS=1
PULUMI_BIN=pulumi
RUNNER_TIMEOUT_SECONDS=1800
RUNNER_LOG_LINES=500

# aws credentials for pulumi (or use a profile)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
